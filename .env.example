# Copy to .env.local. Every variable is server-only; none is shipped to the browser.

# Claude API key. Leave empty to run in mock mode (sample ideas, no cost).
ANTHROPIC_API_KEY=

# Model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# "claude" or "mock". Default: "claude" when a key is set, otherwise "mock".
PLANNER_AI_MODE=

# Requests per minute, per IP, per AI route. Default: 10
RATE_LIMIT_PER_MINUTE=

# Global cap on AI requests per day, across all IPs. Default: 500
AI_DAILY_REQUEST_LIMIT=
